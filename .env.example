# Variables Supabase — copiez ce fichier vers .env puis renseignez vos valeurs.
# Disponibles dans : Supabase Dashboard > Project Settings > API

# URL du projet Supabase (ex : https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clé publique "anon" — sûre à exposer côté client, l'accès réel est
# contrôlé par les policies RLS (voir supabase/migrations/).
VITE_SUPABASE_ANON_KEY=

# Clé "service_role" — usage SERVEUR / SCRIPTS UNIQUEMENT (ex :
# supabase/seed/migrate-products.mjs, futures Edge Functions).
# Ne JAMAIS la préfixer par VITE_ (elle serait alors incluse dans le
# bundle envoyé au navigateur). Ne jamais commiter une vraie valeur.
SUPABASE_SERVICE_ROLE_KEY=
