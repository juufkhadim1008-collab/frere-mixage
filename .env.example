# Variables Supabase — copiez ce fichier vers .env puis renseignez vos valeurs.
# Disponibles dans : Supabase Dashboard > Project Settings > API

# URL du projet Supabase (ex : https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clé publique "anon" — sûre à exposer côté client, l'accès réel est
# contrôlé par les policies RLS (voir supabase/migrations/).
VITE_SUPABASE_ANON_KEY=

# Clé "service_role" — usage SERVEUR / SCRIPTS UNIQUEMENT (Vercel Serverless Functions)
# Ne JAMAIS la préfixer par VITE_ (elle serait incluse dans le bundle public).
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# WAVE BUSINESS CHECKOUT API (https://business.wave.com)
# ==============================================================================
# Clé API secrète (ex: wave_sn_prod_... ou wave_sn_test_...)
WAVE_API_KEY=

# Clé secrète de signature du Webhook Wave (pour valider le header wave-signature)
WAVE_WEBHOOK_SECRET=

# ==============================================================================
# ORANGE MONEY WEB PAYMENT API (https://developer.orange.com)
# ==============================================================================
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# Environnement : 'sandbox' ou 'production'
ORANGE_MONEY_ENV=sandbox
